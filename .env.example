# Runtime
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGINS=http://localhost:5173

# Local paths and persistence (used by subsequent issues)
DATA_DIR=../AI-Builders-Hackathon-2026-Data/Data_Final
DATABASE_URL=sqlite:///./veritas.db

# AI and retrieval (set EMBEDDING_MODEL_PATH_OR_ID after running prepare_data.py)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_READ_TIMEOUT_SECONDS=45
LLM_TOTAL_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_GLOBAL_CONCURRENCY=8
LLM_CALLS_PER_ANALYSIS=16
LLM_MAX_TOKENS=1200
LLM_MAX_RESPONSE_BYTES=262144
LLM_MAX_COST_USD_PER_ANALYSIS=1.0
LLM_TEMPERATURE=0
PROMPT_VERSION=2026-09-10.1
LLM_CACHE_ENABLED=true
LLM_CACHE_RETENTION_DAYS=30
LLM_CACHE_MAX_ROWS=10000
EMBEDDING_MODEL_PATH_OR_ID=
RETRIEVAL_MAX_TOP_K=10
FINANCIAL_LOW_RUNWAY_MONTHS=6
